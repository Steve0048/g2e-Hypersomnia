+/*
+	Game2Earn : commandes tactiles et manette envoyées par la page (assets/g2e-tactile.js).
+	Elles entrent dans le jeu comme le clavier et la souris, à l'image suivante.
+*/
+namespace {
+	struct g2e_entree_type {
+		std::vector<std::pair<int, bool>> touches;
+		int dx = 0;
+		int dy = 0;
+	};
+
+	g2e_entree_type& g2e_entree() {
+		static g2e_entree_type e;
+		return e;
+	}
+
+	augs::event::keys::key g2e_cle(const int numero) {
+		using augs::event::keys::key;
+
+		switch (numero) {
+			case 0: return key::W;
+			case 1: return key::A;
+			case 2: return key::S;
+			case 3: return key::D;
+			case 4: return key::LMOUSE;
+			case 5: return key::RMOUSE;
+			case 6: return key::R;
+			case 7: return key::SPACE;
+			case 8: return key::E;
+			case 9: return key::Q;
+			case 10: return key::B;
+			case 11: return key::C;
+			case 12: return key::ESC;
+			case 13: return key::LSHIFT;
+			case 14: return key::TAB;
+			case 15: return key::_1;
+			case 16: return key::_2;
+			case 17: return key::_3;
+			case 18: return key::MMOUSE;
+			case 19: return key::MOUSE4;
+			case 20: return key::MOUSE5;
+			case 21: return key::J;
+			case 22: return key::WHEELDOWN;
+			case 23: return key::WHEELUP;
+			case 24: return key::Z;
+			case 25: return key::X;
+			case 26: return key::V;
+			case 27: return key::G;
+			case 28: return key::H;
+			case 29: return key::F;
+			case 30: return key::LCTRL;
+			default: return key::INVALID;
+		}
+	}
+}
+
+extern "C" {
+	EMSCRIPTEN_KEEPALIVE void g2e_touche(const int numero, const int appuyee) {
+		g2e_entree().touches.emplace_back(numero, appuyee != 0);
+	}
+
+	EMSCRIPTEN_KEEPALIVE void g2e_viser(const int dx, const int dy) {
+		g2e_entree().dx += dx;
+		g2e_entree().dy += dy;
+	}
+}
