+}
+
+/*
+	Game2Earn : ce que le joueur peut faire maintenant (relevé par view/mode_gui/arena/arena_context_tip.h), en bits :
+	1 connu (relevé de moins d'une demi-seconde), 2 interagir, 4 acheter, 8 porte la bombe, 16 arme à feu en main,
+	32 à 224 : ce que tient la main principale (0 rien, 1 arme à feu, 2 arme blanche, 3 grenade, 4 bombe) multiplié par 32,
+	256 à 3840 : les grenades (explosive, PED, aveuglante, interférence) multipliées par 256, 4096 un couteau à lancer,
+	8192 au moins deux armes.
+*/
+extern "C" EMSCRIPTEN_KEEPALIVE int g2e_commandes() {
+	const auto& g = g2e::commandes();
+
+	if (emscripten_get_now() - g.le > 500.0) {
+		return 0;
+	}
+
+	return 1
+		| (g.interagir ? 2 : 0)
+		| (g.acheter ? 4 : 0)
+		| (g.bombe ? 8 : 0)
+		| (g.arme_a_feu ? 16 : 0)
+		| (g.en_main << 5)
+		| (g.grenades << 8)
+		| (g.couteaux ? 4096 : 0)
+		| (g.armes >= 2 ? 8192 : 0)
+	;
+}
